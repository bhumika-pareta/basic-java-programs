import java.util.*;
class Sum {

    public void add(int n){
        int sum=0;
        for(int i=1; i<=n ; i++){
            if(i%2!=0){
                 sum = sum + i;
            }
        
        }
        System.out.println(sum);
    }

}
public class Y {
    public static void main(String args[]){
Scanner sc = new Scanner(System.in);
System.out.println("Enter the value of n");
int n = sc.nextInt();

Sum s1 = new Sum();

s1.add(n);

    }
}
